# هذا الملف مرجعي فقط - يوثّق أسماء المفاتيح المستخدمة في المشروع
# القيم الفعلية لا تُوضع هنا ولا في التطبيق إطلاقًا
#
# كل هذه المفاتيح تُدار حصريًا كـ Firebase Secrets داخل functions/index.js
# عبر: firebase functions:secrets:set <KEY_NAME>
# راجع قسم "نشر Cloud Function" في README لمعرفة التفاصيل

OPENAI_API_KEY=          # يُستخدم في: chatCompletion, generateImage, generateLogo, summarizeText,
                          # translateText, extractTextFromImage, polishResumeSummary, generateWriting,
                          # generateAvatar, generateWallpaper, codeAssist
REMOVE_BG_API_KEY=       # يُستخدم في removeBackground
REPLICATE_API_TOKEN=     # يُستخدم في enhanceImage (Real-ESRGAN)
REVENUECAT_WEBHOOK_SECRET=  # يُستخدم في revenueCatWebhook للتحقق من مصدر الطلب

# ‼️ ملاحظة: مفاتيح RevenueCat SDK (iOS/Android) ليست أسرارًا من هذا النوع -
# هي مفاتيح عامة تُوضع مباشرة داخل التطبيق نفسه في
# lib/core/config/revenuecat_config.dart (راجع الملف للتفاصيل)
